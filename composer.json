{
    "name": "ethen/e-docx-parser",
    "description": "A PHP library for parsing DOCX files",
    "type": "library",
    "version": "1.0.10",
    "autoload": {
        "psr-4": {
            "EDocxParser\\": "src/"
        }
    },
    "bin": [
        "bin/docx-reader",
        "bin/docx-parser"
    ],
    "authors": [
        {
            "name": "Ethen",
            "email": "hqk616@163.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "autoload-dev": {
        "psr-4": {
            "EDocxParser\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "scripts": {
        "docx:read": "@php bin/docx-reader",
        "docx:parse": "@php bin/docx-parser"
    }
}